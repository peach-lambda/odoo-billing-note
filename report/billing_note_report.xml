<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_billing_note" model="ir.actions.report">
        <field name="name">Billing Note</field>
        <field name="model">customer.billing.note</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_billing_note.report_billing_note</field>
        <field name="report_file">customer_billing_note.report_billing_note</field>
        <field name="print_report_name">'Billing Note - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_customer_billing_note"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Wrapper Template -->
    <template id="report_billing_note">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="customer_billing_note.report_billing_note_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- Document Template with Clean Odoo 18 Grid Layout -->
    <template id="report_billing_note_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page">
                <div class="oe_structure"/>
                
                <!-- Title & Header Info -->
                <div class="row mt-4 mb-4">
                    <div class="col-7">
                        <span class="text-muted">Customer:</span>
                        <h4 class="mb-1" t-field="doc.partner_id.name"/>
                        <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": True}'/>
                        <div t-if="doc.partner_id.vat" class="mt-1">
                            <strong>Tax ID:</strong> <span t-field="doc.partner_id.vat"/>
                        </div>
                    </div>
                    <div class="col-5 text-end">
                        <h2 class="text-primary"><strong>Billing Note</strong></h2>
                        <h3 class="text-secondary" t-field="doc.name"/>
                        <div class="mt-3">
                            <div><strong>Date:</strong> <span t-field="doc.date"/></div>
                            <div t-if="doc.due_date"><strong>Due Date:</strong> <span t-field="doc.due_date"/></div>
                            <div><strong>Status:</strong> <span t-field="doc.state"/></div>
                        </div>
                    </div>
                </div>

                <!-- Invoices Table -->
                <table class="table table-sm o_main_table mt-4">
                    <thead>
                        <tr>
                            <th class="text-start">Invoice Number</th>
                            <th class="text-center">Invoice Date</th>
                            <th class="text-center">Due Date</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-end">Amount Due</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.invoice_ids" t-as="inv">
                            <tr>
                                <td class="text-start"><span t-field="inv.name"/></td>
                                <td class="text-center"><span t-field="inv.invoice_date"/></td>
                                <td class="text-center"><span t-field="inv.invoice_date_due"/></td>
                                <td class="text-end"><span t-field="inv.amount_total"/></td>
                                <td class="text-end"><span t-field="inv.amount_residual"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Totals Section -->
                <div class="clearfix mt-4">
                    <div id="total" class="row">
                        <div class="col-6 ms-auto">
                            <table class="table table-sm" style="page-break-inside: avoid;">
                                <tr class="border-black">
                                    <td><strong>Total Outstanding</strong></td>
                                    <td class="text-end">
                                        <span t-field="doc.total_amount"/>
                                    </td>
                                </tr>
                                <tr class="border-black fw-bold">
                                    <td><strong>Balance Due</strong></td>
                                    <td class="text-end">
                                        <span t-field="doc.amount_residual"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div t-if="doc.note" class="mt-4">
                    <p><strong>Terms &amp; Notes:</strong></p>
                    <p t-field="doc.note"/>
                </div>
                
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
</odoo>
